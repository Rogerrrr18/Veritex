# 统一模型管理配置文件示例
# 复制此文件为 .env 并填入您的实际API密钥

# ==============================================
# 当前使用的模型 (必填)
# 支持: qwen, openai, claude, deepseek
# ==============================================
ACTIVE_MODEL=openai

# ==============================================
# 千问 (Qwen) 配置
# ==============================================
QWEN_API_KEY=sk-7ec5107d41af4d809d702303013be7f7
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-plus
QWEN_TEMPERATURE=0.3
QWEN_MAX_TOKENS=1500

# ==============================================
# OpenAI 配置
# ==============================================
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1500

# ==============================================
# Claude 配置
# ==============================================
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL_NAME=claude-3-sonnet-20240229
CLAUDE_TEMPERATURE=0.3
CLAUDE_MAX_TOKENS=1500

# ==============================================
# DeepSeek 配置
# ==============================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=1500

# ==============================================
# LangSmith 追踪 (可选)
# ==============================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=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
LANGCHAIN_PROJECT=papergod
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LangSmith集成配置
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=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
LANGSMITH_PROJECT=papergod

# ==============================================
# 调试配置 (可选)
# ==============================================
DEBUG=True
WORKFLOW_LOG_LEVEL=DEBUG

# ==============================================
# 使用说明
# ==============================================
# 1. 只需要配置您要使用的模型的API密钥
# 2. 修改 ACTIVE_MODEL 来切换模型
# 3. 重启服务即可生效
# 4. 支持的模型会在 /models 接口中显示

# 示例切换步骤：
# 从千问切换到OpenAI:
# 1. 确保 OPENAI_API_KEY 已填写
# 2. 修改 ACTIVE_MODEL=openai
# 3. 重启服务: python -m uvicorn integrated_backend:app --reload

# 从OpenAI切换到Claude:
# 1. 确保 CLAUDE_API_KEY 已填写
# 2. 修改 ACTIVE_MODEL=claude
# 3. 重启服务