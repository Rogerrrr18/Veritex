# 基础镜像可通过构建参数覆盖，便于绕过 docker.io 访问限制
ARG BASE_IMAGE_PY=python:3.11-slim
FROM ${BASE_IMAGE_PY} AS base

# 设置时区和基础依赖 + pip国内源
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com

# 使用可配置 Debian 镜像源，自动检测系统 codename，避免固定 trixie 导致 502
ARG DEBIAN_MIRROR=deb.debian.org
RUN set -eux; \
    codename="$(grep -Po '(?<=VERSION_CODENAME=)[^\n]+' /etc/os-release || echo bookworm)"; \
    echo "Using mirror: ${DEBIAN_MIRROR}, codename: ${codename}"; \
    rm -f /etc/apt/sources.list.d/debian.sources || true; \
    printf 'deb http://%s/debian %s main contrib non-free non-free-firmware\n' "${DEBIAN_MIRROR}" "${codename}" > /etc/apt/sources.list; \
    printf 'deb http://%s/debian %s-updates main contrib non-free non-free-firmware\n' "${DEBIAN_MIRROR}" "${codename}" >> /etc/apt/sources.list; \
    printf 'deb http://%s/debian %s-backports main contrib non-free non-free-firmware\n' "${DEBIAN_MIRROR}" "${codename}" >> /etc/apt/sources.list; \
    apt-get update -o Acquire::Retries=3 && apt-get install -y --no-install-recommends \
      build-essential \
      curl \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 仅复制依赖文件以利用构建缓存
COPY requirements.txt /app/requirements.txt

# 安装依赖（使用阿里云pip源）
RUN python -m pip install --upgrade pip -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com \
    && awk '!/^volcengine-ark/{print}' /app/requirements.txt > /tmp/requirements.no-ark.txt \
    && pip install --no-cache-dir -r /tmp/requirements.no-ark.txt -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com \
    && (pip install --no-cache-dir volcengine-ark -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com || echo "skip volcengine-ark (optional)")

# 复制源码
COPY . /app

# 暴露端口
EXPOSE 8000

# 健康检查（可选）
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/health | grep -q '"status": "healthy"' || exit 1

# 运行（使用更健壮的生产参数）
CMD ["python", "-m", "uvicorn", "backend:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--timeout-keep-alive", "300"]
