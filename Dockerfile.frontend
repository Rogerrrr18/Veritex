# Frontend: Vite build -> Nginx serve (independent image)

FROM node:20-bookworm-slim AS build
WORKDIR /app/frontend

# Copy full project (frontend) and install
COPY frontend .
# 避免宿主机生成的 package-lock.json 影响可选依赖解析，并显式安装 Rollup 原生包（arm64/gnu）
RUN rm -f package-lock.json \
  && npm install --no-audit --no-fund \
  && npm rebuild \
  && (npm install -D @rollup/rollup-linux-arm64-gnu || true) \
  && npm run build

# Runtime
FROM nginx:alpine AS runtime

ENV BACKEND_URL=http://backend:8000
WORKDIR /usr/share/nginx/html

# Copy built assets
COPY --from=build /app/frontend/dist .

# Templated nginx config -> supports dynamic BACKEND_URL via envsubst
COPY nginx.template.conf /etc/nginx/templates/default.conf.template
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80
CMD ["/docker-entrypoint.sh"]


