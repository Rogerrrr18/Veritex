{
  "version": "3.0",
  "description": "Google Scholar MCP服务配置 - 专注于学术文献搜索",
  "mcpServices": {
    "google_scholar": {
      "name": "Google Scholar",
      "description": "Google Scholar学术搜索服务",
      "enabled": true,
      "mcp_server": {
        "command": "python",
        "args": ["-m", "google_scholar_mcp_server"]
      },
      "tools": {
        "search_google_scholar_key_words": {
          "description": "使用关键词搜索Google Scholar论文",
          "parameters": {
            "query": {
              "type": "string",
              "description": "搜索关键词"
            },
            "num_results": {
              "type": "integer",
              "description": "返回结果数量",
              "default": 10,
              "maximum": 50
            }
          }
        },
        "search_google_scholar_advanced": {
          "description": "Google Scholar高级搜索",
          "parameters": {
            "query": {
              "type": "string",
              "description": "搜索查询"
            },
            "author": {
              "type": "string",
              "description": "作者名称",
              "optional": true
            },
            "year_low": {
              "type": "integer",
              "description": "起始年份",
              "optional": true
            },
            "year_high": {
              "type": "integer",
              "description": "结束年份",
              "optional": true
            },
            "num_results": {
              "type": "integer",
              "description": "返回结果数量",
              "default": 10,
              "maximum": 50
            }
          }
        },
        "get_author_info": {
          "description": "获取作者详细信息",
          "parameters": {
            "author_name": {
              "type": "string",
              "description": "作者姓名"
            }
          }
        }
      },
      "field_mapping": {
        "title": "title",
        "abstract": "abstract",
        "authors": "authors",
        "year": "year",
        "venue": "venue",
        "citations": "num_citations",
        "url": "url",
        "pdf_url": "pdf_link"
      },
      "rate_limit": {
        "requests_per_minute": 30,
        "delay_between_requests": 2.0
      }
    }
  },
  "search_strategies": {
    "basic": {
      "description": "基础关键词搜索",
      "tool": "search_google_scholar_key_words",
      "timeout": 15,
      "max_results": 10
    },
    "advanced": {
      "description": "高级搜索（支持作者、年份筛选）",
      "tool": "search_google_scholar_advanced",
      "timeout": 20,
      "max_results": 15
    },
    "comprehensive": {
      "description": "综合搜索（包含作者信息）",
      "tools": ["search_google_scholar_advanced", "get_author_info"],
      "timeout": 30,
      "max_results": 20
    }
  },
  "workflow_config": {
    "memory": {
      "enabled": true,
      "store_type": "memory",
      "max_messages": 20,
      "thread_id_generation": "uuid"
    },
    "human_in_loop": {
      "enabled": true,
      "approval_points": [
        "before_search",
        "after_analysis",
        "before_final_output"
      ],
      "timeout_seconds": 300
    },
    "system_prompt": {
      "enabled": true,
      "template_path": "prompts/literature_search_agent.txt"
    }
  },
  "data_processing": {
    "deduplication": {
      "enabled": true,
      "similarity_threshold": 0.85,
      "fields": ["title", "authors"]
    },
    "result_formatting": {
      "output_format": "table",
      "required_fields": [
        "title", "author", "doi", "year", "abstract", 
        "journal", "keywords", "citation_count", 
        "research_type", "access_status"
      ]
    }
  },
  "global_settings": {
    "timeout_seconds": 30,
    "retry_attempts": 3,
    "enable_caching": true,
    "cache_ttl_seconds": 1800,
    "max_concurrent_requests": 3,
    "default_limit": 15
  }
}