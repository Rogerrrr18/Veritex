{
  "version": "2.0",
  "description": "通用MCP服务配置 - 零代码添加新服务",
  "mcpServices": {
    "arxiv": {
      "name": "arXiv",
      "description": "arXiv预印本论文库",
      "enabled": true,
      "base_url": "http://export.arxiv.org/api/query",
      "method": "GET",
      "auth": {
        "type": "none"
      },
      "search_config": {
        "endpoint": "",
        "param_mapping": {
          "query": "search_query",
          "limit": "max_results",
          "category": "category"
        },
        "query_template": "all:{query}",
        "category_template": "cat:{category} AND all:{query}",
        "additional_params": {
          "sortBy": "relevance",
          "sortOrder": "descending"
        }
      },
      "response_config": {
        "format": "rss",
        "papers_path": "entries",
        "field_mapping": {
          "id": "id",
          "title": "title", 
          "abstract": "summary",
          "authors": "authors",
          "year": "published",
          "published": "published",
          "updated": "updated",
          "url": "link",
          "categories": "tags",
          "doi": "doi"
        },
        "transform": {
          "authors": "extract_names",
          "categories": "extract_terms",
          "arxiv_id": "extract_from_id",
          "year": "extract_year_from_date"
        }
      },
      "rate_limit": {
        "requests_per_minute": 60,
        "delay_between_requests": 1.0
      }
    },
    "semantic_scholar": {
      "name": "Semantic Scholar",
      "description": "Semantic Scholar学术搜索",
      "enabled": false,
      "base_url": "https://api.semanticscholar.org/graph/v1",
      "method": "GET",
      "auth": {
        "type": "header",
        "header_name": "x-api-key",
        "env_var": "SEMANTIC_SCHOLAR_API_KEY"
      },
      "search_config": {
        "endpoint": "/paper/search",
        "param_mapping": {
          "query": "query",
          "limit": "limit",
          "year": "year",
          "venue": "venue"
        },
        "additional_params": {
          "fields": "paperId,title,abstract,authors,venue,year,citationCount,url,openAccessPdf"
        }
      },
      "response_config": {
        "format": "json",
        "papers_path": "data",
        "field_mapping": {
          "id": "paperId",
          "title": "title",
          "abstract": "abstract", 
          "authors": "authors",
          "year": "year",
          "venue": "venue",
          "citations": "citationCount",
          "url": "url",
          "pdf_url": "openAccessPdf.url"
        },
        "transform": {
          "authors": "extract_author_names"
        }
      },
      "rate_limit": {
        "requests_per_minute": 100,
        "delay_between_requests": 0.6
      }
    },
    "crossref": {
      "name": "CrossRef",
      "description": "CrossRef学术文献数据库",
      "enabled": true,
      "base_url": "https://api.crossref.org",
      "method": "GET", 
      "auth": {
        "type": "none"
      },
      "search_config": {
        "endpoint": "/works",
        "param_mapping": {
          "query": "query.title",
          "limit": "rows"
        },
        "additional_params": {
          "sort": "relevance",
          "order": "desc"
        }
      },
      "response_config": {
        "format": "json",
        "papers_path": "message.items",
        "field_mapping": {
          "id": "DOI",
          "title": "title[0]",
          "abstract": "abstract",
          "authors": "author",
          "year": "published-print.date-parts[0][0]",
          "venue": "container-title[0]",
          "url": "URL"
        },
        "transform": {
          "authors": "extract_given_family_names",
          "title": "extract_first_element"
        }
      },
      "rate_limit": {
        "requests_per_minute": 50,
        "delay_between_requests": 1.2
      }
    },
    "pubmed": {
      "name": "PubMed",
      "description": "PubMed生物医学文献数据库",
      "enabled": true,
      "base_url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils",
      "method": "GET",
      "auth": {
        "type": "none"
      },
      "search_config": {
        "endpoint": "/esearch.fcgi",
        "param_mapping": {
          "query": "term",
          "limit": "retmax"
        },
        "additional_params": {
          "db": "pubmed",
          "retmode": "json",
          "sort": "relevance"
        }
      },
      "response_config": {
        "format": "json",
        "papers_path": "esearchresult.idlist",
        "requires_detail_fetch": true,
        "detail_endpoint": "/efetch.fcgi",
        "detail_params": {
          "db": "pubmed",
          "retmode": "xml",
          "rettype": "abstract"
        },
        "field_mapping": {
          "id": "PMID",
          "title": "ArticleTitle",
          "abstract": "Abstract",
          "authors": "AuthorList.Author",
          "year": "PubDate.Year",
          "venue": "Journal.Title"
        }
      },
      "rate_limit": {
        "requests_per_minute": 100,
        "delay_between_requests": 0.6
      }
    }
  },
  "search_strategies": {
    "fast": {
      "description": "快速搜索策略",
      "sources": ["arxiv"],
      "parallel": true,
      "timeout": 10,
      "max_results_per_source": 10
    },
    "comprehensive": {
      "description": "全面搜索策略", 
      "sources": ["arxiv", "crossref", "pubmed"],
      "parallel": true,
      "timeout": 30,
      "max_results_per_source": 20
    },
    "academic": {
      "description": "学术搜索策略",
      "sources": ["semantic_scholar", "crossref"],
      "parallel": true,
      "timeout": 20,
      "max_results_per_source": 15
    }
  },
  "data_processing": {
    "deduplication": {
      "enabled": true,
      "similarity_threshold": 0.85,
      "fields": ["title", "doi", "authors"]
    },
    "relevance_scoring": {
      "enabled": true,
      "factors": {
        "title_match": 0.4,
        "abstract_match": 0.3,
        "author_match": 0.1,
        "venue_match": 0.1,
        "citation_count": 0.1
      }
    },
    "result_ranking": {
      "primary": "relevance_score",
      "secondary": "citation_count",
      "order": "desc"
    }
  },
  "global_settings": {
    "timeout_seconds": 30,
    "retry_attempts": 3,
    "enable_caching": true,
    "cache_ttl_seconds": 3600,
    "max_concurrent_requests": 5,
    "default_limit": 20
  }
}