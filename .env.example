ACTIVE_MODEL=openai

# OpenAI-compatible model endpoint.
# You can either use OPENAI_* variables or the legacy ARK_* compatibility variables below.
# Never commit real API keys.
ARK_API_KEY=your_model_api_key
ARK_BASE_URL=https://your-provider.example/v1/
ARK_MODEL_NAME=your-model-name
ARK_TEMPERATURE=0.3
ARK_MAX_TOKENS=2000

# Timeout configuration
SEARCH_TASK_TIMEOUT=60.0
LLM_TIMEOUT=120.0
SIMPLE_CHAT_TIMEOUT=30.0
COMPLEX_QUERY_TIMEOUT=90.0
ACADEMIC_SEARCH_TIMEOUT=120.0

# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Search sources
USE_VPN_PROXY=false
SCHOLARLY_SCHOLAR_ENABLED=true
SCHOLAR_DOCK_ENABLED=true
ARXIV_ENABLED=true
CROSSREF_ENABLED=true
