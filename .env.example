# Paper God 智能学术搜索系统 - 环境变量配置示例

# =============================================================================
# LLM 配置 (必需)
# =============================================================================
# 选择主要LLM提供商: openai, anthropic, deepseek, qwen, doubao
DEFAULT_LLM_PROVIDER=openai

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# DeepSeek配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问配置
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-turbo

# 豆包配置
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_ENDPOINT=your_doubao_endpoint_here
DOUBAO_MODEL=your_doubao_model_here

# =============================================================================
# 数据源配置
# =============================================================================
# Semantic Scholar
SEMANTIC_SCHOLAR_ENABLED=true

# Google Scholar (推荐启用)
GOOGLE_SCHOLAR_ENABLED=true
SCHOLAR_PY_ENABLED=false

# 其他数据源 (可选)
CROSSREF_ENABLED=false
PUBMED_ENABLED=false
PUBMED_API_KEY=your_pubmed_api_key_here


# =============================================================================
# 系统配置
# =============================================================================
# 应用端口
PORT=8000

# 日志级别
LOG_LEVEL=INFO

# 性能监控
ENABLE_PERFORMANCE_MONITORING=true

# Supabase配置 (用户管理)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# 前端配置
# =============================================================================
# 前端开发服务器端口
FRONTEND_PORT=3000

# API基础URL
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# 其他配置
# =============================================================================
# 缓存配置
ENABLE_CACHE=true
CACHE_TTL=3600

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# 开发模式
ENVIRONMENT=development