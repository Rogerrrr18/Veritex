# Paper God 3.0 智能对话版环境配置示例
# 复制此文件为 .env 并填入真实值

# =============================================================================
# LLM模型配置（至少配置一个）
# =============================================================================

# 当前激活的模型（可选：openai, qwen, claude, deepseek）
ACTIVE_MODEL=openai

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1500

# 通义千问配置（阿里云）
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-turbo
QWEN_TEMPERATURE=0.3
QWEN_MAX_TOKENS=1500

# Claude配置（Anthropic）
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL_NAME=claude-3-sonnet-20240229
CLAUDE_TEMPERATURE=0.3
CLAUDE_MAX_TOKENS=1500

# DeepSeek配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=1500

# =============================================================================
# LangGraph工作流配置
# =============================================================================

# LangSmith追踪（可选）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=paper-god-intelligent

# 工作流配置
WORKFLOW_LOG_LEVEL=INFO
WORKFLOW_MEMORY_ENABLED=true
WORKFLOW_MAX_THREADS=10

# =============================================================================
# 学术搜索配置
# =============================================================================

# Semantic Scholar API（无需密钥，但可配置请求限制）
SEMANTIC_SCHOLAR_REQUEST_DELAY=1.0

# arXiv API配置
ARXIV_REQUEST_DELAY=1.0
ARXIV_MAX_RESULTS_PER_REQUEST=100

# PubMed API配置
PUBMED_API_KEY=your_pubmed_api_key_here
PUBMED_REQUEST_DELAY=1.0
PUBMED_MAX_RESULTS_PER_REQUEST=100

# Google Scholar配置（通过代理或直接访问）
# 注意：由于网络连接问题，建议暂时禁用Google Scholar
GOOGLE_SCHOLAR_ENABLED=false
GOOGLE_SCHOLAR_REQUEST_DELAY=3.0
GOOGLE_SCHOLAR_MAX_RESULTS_PER_REQUEST=20

# Crossref API配置（开放数据源）
# 注意：由于网络连接问题，建议暂时禁用Crossref
CROSSREF_ENABLED=false
CROSSREF_REQUEST_DELAY=1.0

# IEEE Xplore API配置（需要API密钥）
IEEE_API_KEY=your_ieee_api_key_here
IEEE_ENABLED=true

# Springer API配置（需要API密钥）  
SPRINGER_API_KEY=your_springer_api_key_here
SPRINGER_ENABLED=true

# Supabase配置（用于用户分析，可选）
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_TABLE=papers

# =============================================================================
# 服务器配置
# =============================================================================

# API服务器设置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# 日志级别
LOG_LEVEL=INFO

# =============================================================================
# 智能分析配置
# =============================================================================

# 关键词扩展设置
MAX_EXPANDED_KEYWORDS=5
KEYWORD_EXPANSION_TIMEOUT=10
ANALYSIS_CACHE_TTL=1800

# 学术分析阈值
ACADEMIC_QUERY_CONFIDENCE_THRESHOLD=0.7
MAX_SEARCH_RESULTS=50
DEFAULT_SEARCH_RESULTS=20

# =============================================================================
# 缓存和性能配置
# =============================================================================

# 搜索缓存设置
SEARCH_CACHE_TTL=3600
MAX_CACHE_SIZE=1000

# 并发控制
MAX_CONCURRENT_SEARCHES=10
SEARCH_TIMEOUT=60
LLM_REQUEST_TIMEOUT=30

# =============================================================================
# 开发环境配置
# =============================================================================

# 开发模式
DEBUG=false
RELOAD=false

# CORS配置
CORS_ORIGINS=*
CORS_CREDENTIALS=true

# =============================================================================
# 数据源权重配置
# =============================================================================

# 各数据源的权重和优先级
SEMANTIC_SCHOLAR_WEIGHT=1.2
ARXIV_WEIGHT=1.0
PAPERSCRAPER_WEIGHT=0.8

# 搜索结果过滤
MIN_RELEVANCE_SCORE=1.0
MIN_CITATION_COUNT=0
MIN_YEAR=2010

# =============================================================================
# 监控和分析
# =============================================================================

# 性能监控
ENABLE_PERFORMANCE_TRACKING=true
PERFORMANCE_LOG_INTERVAL=3600

# 用户分析
ENABLE_USER_ANALYTICS=false
ANALYTICS_BATCH_SIZE=100

# 智能对话监控
ENABLE_CHAT_ANALYTICS=true
CHAT_RESPONSE_TIME_THRESHOLD=10
CHAT_ERROR_RATE_THRESHOLD=0.05

# =============================================================================
# 高级功能配置（预留）
# =============================================================================

# Token计费管理
ENABLE_TOKEN_TRACKING=true
TOKEN_COST_TRACKING=true
MAX_TOKENS_PER_SESSION=10000
MAX_DAILY_TOKENS_PER_USER=50000

# 多轮对话管理
MAX_CONVERSATION_HISTORY=20
CONVERSATION_MEMORY_TTL=86400

# 智能响应优化
ENABLE_RESPONSE_STREAMING=true
ENABLE_TYPING_INDICATOR=true